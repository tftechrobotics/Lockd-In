<?xml version="1.0" encoding="utf-8"?>
<!-- Play (release) build: remove the optional accessibility detector entirely,
     so the bundle declares no AccessibilityService. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name=".ProbeAccessibilityService"
            tools:node="remove" />
    </application>
</manifest>
