<Window
    x:Class="LockdIn.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Minimal title bar: app mark + name; the system draws the caption buttons. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock x:Name="TitleText" Text="Lockd In" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!-- WebView2 is created in code so a failure is reported instead of failing XAML parsing. -->
        <Border x:Name="ViewHost" Grid.Row="1" />
        <StackPanel x:Name="LoadError" Grid.Row="1" Visibility="Collapsed" Spacing="12"
                    MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
            <TextBlock Text="Lockd In can’t show its window" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="LoadErrorText" TextWrapping="Wrap" />
            <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap"
                       Text="Download: developer.microsoft.com/microsoft-edge/webview2" />
        </StackPanel>
    </Grid>
</Window>
