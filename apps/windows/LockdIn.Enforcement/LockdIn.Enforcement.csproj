<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure rules for the Windows blocking agent (no Windows APIs): the plan the interface
       hands to the agent, what counts as restricted, and the agent's status report.
       Compiled into the agent and unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
