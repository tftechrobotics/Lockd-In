<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs anywhere (no Windows APIs): the shell's message validation and the agent's pure rules. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\LockdIn.Desktop\Bridge.cs" Link="Bridge.cs" />
    <ProjectReference Include="..\LockdIn.Enforcement\LockdIn.Enforcement.csproj" />
  </ItemGroup>
</Project>
