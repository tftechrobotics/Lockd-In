<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Blocking (each one is explained in the app before the user grants it):
         usage access to see which app is in front; "display over other apps" so the block
         screen may come to the front from the background (Android's documented exemption);
         a foreground service so blocking runs without the app window. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Calendar suggestions (C): read-only, only after the person turns them on. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Location routines (E): only after the person adds a place and allows it. Precise
         location to save a place; "all the time" because Android requires it for geofences. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Ambient study sound plays from the session service (B2). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Resume a running session after a restart; re-arm planned sessions. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- On-time automatic starts. The user grants it in Settings ("Alarms & reminders"); without
         it, starts use inexact alarms and the app says they may be late. Not USE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Optional Accessibility mode (owner decision 2026-11-01): see FocusAccessibilityService.
         No QUERY_ALL_PACKAGES, no VPN, no exact alarms. -->

    <!-- Package visibility: only apps with a launcher icon (to choose them in a profile),
         plus the home screen and Settings (never blocked). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- Browsers (apps that open web links): for "allow only these websites". -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".LockdInApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LockdIn">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Block screen: its own task so it never mixes with the app's back stack. -->
        <activity
            android:name=".enforce.BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="app.lockdin.block" />

        <!-- Music control (B2, R47): notification access lets Lockd In control the music app's
             player. It overrides no notification callbacks, so it never reads notifications. -->
        <service
            android:name=".audio.MediaAccessService"
            android:exported="true"
            android:label="Lockd In music control"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".enforce.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaPlayback">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started focus session that blocks apps the user chose until the session ends." />
        </service>

        <!-- Optional, user-enabled in Settings after an in-app disclosure. Reads only which app
             is in front and, in supported browsers, the address bar, during focus. -->
        <service
            android:name=".enforce.FocusAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Planned sessions: the next alarm, plus reboot, clock, time-zone and exact-alarm
             permission changes (all exempt from implicit-broadcast limits). -->
        <receiver
            android:name=".sched.PlanReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".sched.PlanActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".enforce.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
            <!-- History export (CSV): shared through Android's share sheet with read access only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- Home-screen widget (C): next session or the running one with its countdown. -->
        <receiver android:name=".widget.LockdInWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".sched.CheckInReceiver" android:exported="false" />
        <receiver android:name=".loc.GeofenceReceiver" android:exported="false" />
        <receiver android:name=".loc.PlaceActionReceiver" android:exported="false" />
</application>
</manifest>
