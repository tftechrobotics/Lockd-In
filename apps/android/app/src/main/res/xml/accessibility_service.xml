<?xml version="1.0" encoding="utf-8"?>
<!-- Lockd In's optional blocking mode. Not an accessibility tool (isAccessibilityTool=false): it
     sees which app comes to the front and, in supported browsers, the address-bar text, during
     focus sessions only. It performs no gestures or actions in other apps. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:description="@string/a11y_description" />
