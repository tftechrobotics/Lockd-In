    <application>
        <receiver
            android:name="app.lockdin.debug.TestControl"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.lockdin.debug.CONTROL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
