{
  "name": "lockdin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-tokens.mjs && tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test",
    "assets": "node scripts/build-wordmark.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "preview-page": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "6.1.2",
    "opentype.js": "2.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
